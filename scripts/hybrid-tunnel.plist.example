<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>dk.kaia.demo.tunnel</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>__CLOUDFLARED_BINARY__</string>
		<string>tunnel</string>
		<string>--no-autoupdate</string>
		<string>--protocol</string>
		<string>http2</string>
		<string>--url</string>
		<string>http://127.0.0.1:3212</string>
		<string>--metrics</string>
		<string>127.0.0.1:20242</string>
		<string>--loglevel</string>
		<string>info</string>
		<string>--output</string>
		<string>json</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__KAIA_RUNTIME_DIR__/tunnel.stderr.log</string>
	<key>StandardOutPath</key>
	<string>__KAIA_RUNTIME_DIR__/tunnel.stdout.log</string>
	<key>ThrottleInterval</key>
	<integer>15</integer>
	<key>WorkingDirectory</key>
	<string>__KAIA_RUNTIME_DIR__</string>
</dict>
</plist>
