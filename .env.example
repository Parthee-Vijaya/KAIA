# K.A.I.A. — kun eksempelværdier. Kopiér til .env.local lokalt; brug Vercel environment variables i hosting.
# Denne base-URL bruges til Origin-kontrol og den registrerede Entra callback.
KAIA_APP_URL=http://127.0.0.1:3210
# demo: tydeligt demologin med tre ikke-administrative profiler. entra: rigtigt Microsoft-login.
KAIA_AUTH_MODE=entra
# Hybrid: kun på Vercel. Fast HTTPS-origin til lokal backend. Ingen DB-/modelnøgler på frontenden.
KAIA_REMOTE_BACKEND_URL=
# Samme tilfældige minimum 48 tegn på begge servere. ALDRIG NEXT_PUBLIC_ eller i browseren.
KAIA_REMOTE_GATEWAY_KEY=
# Kun på lokal backend bag HTTPS-tunnel: afvis alle usignerede forespørgsler.
KAIA_REQUIRE_GATEWAY=0
# Callback: ${KAIA_APP_URL}/auth/callback — registrér den nøjagtige HTTPS-URL for hvert hostmiljø.
# Entra single tenant. UUID'er fra app registration; hemmeligheden er dens secret VALUE.
KAIA_ENTRA_TENANT_ID=
KAIA_ENTRA_CLIENT_ID=
KAIA_ENTRA_CLIENT_SECRET=
# Tilfældigt minimum 32 tegn, fx node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
KAIA_SESSION_SECRET=
# Præcis 32 tilfældige bytes base64-kodet. Beskyt og sikkerhedskopiér nøglen separat fra DB.
KAIA_ENCRYPTION_KEY=
# Postgres pooled URL (fx Neon/Vercel integration). Node-runtime, prepare:false, pool max=3.
DATABASE_URL=postgresql://user:password@database.example/kaia?sslmode=require
# Valgfrie visningsprofiler kobles EKSKLUSIVT til tenant UUID:object UUID, aldrig navn/email.
KAIA_PARTHEE_IDENTITY=
KAIA_ANNE_IDENTITY=
# Normalt demo. En ekstern model skal bestå administratorens forbindelsestest før brug.
KAIA_DEFAULT_PROVIDER=demo
KAIA_OPENAI_API_KEY=
KAIA_OPENAI_MODEL=
KAIA_OPENAI_ENDPOINT=https://api.openai.com/v1
KAIA_MISTRAL_API_KEY=
KAIA_MISTRAL_MODEL=
KAIA_MISTRAL_ENDPOINT=https://api.mistral.ai/v1
KAIA_AZURE_OPENAI_API_KEY=
# v1-rute: deploymentnavnet bruges direkte som modelværdi. Ingen implicit api-version.
KAIA_AZURE_OPENAI_DEPLOYMENT=
KAIA_AZURE_OPENAI_ENDPOINT=https://example-resource.openai.azure.com/openai/v1
KAIA_CORTI_API_KEY=
KAIA_CORTI_MODEL=
# eu, us eller fr. Regionen skal matche projektets adgang; ingen automatisk fallback.
# FR-forbindelse er konkret endpointverificeret; offentlige Models-regionsdocs viser EU/US.
KAIA_CORTI_REGION=eu
# Ved fr: https://ai.fr.corti.app/v1. Udelad endpoint for valgt regions standardhost.
KAIA_CORTI_ENDPOINT=https://ai.eu.corti.app/v1
# apiKey eller oauth. OAuth bruger auth.{region}.corti.app, IKKE Cortis Healthcare API.
KAIA_CORTI_AUTH_MODE=apiKey
KAIA_CORTI_CLIENT_ID=
KAIA_CORTI_CLIENT_SECRET=
KAIA_CORTI_TENANT=base
# v4: 2020–2032, 1.245.024 økonomiposteringer, 1.742 dokumenter og 16.506 kommunebenchmarkrækker.
# Seks kommuners økonomi og struktur er simuleret; kun navne og kommunekoder er officielle.
# Samme version kræver identisk seed + reference. Nyt snapshot får en ny version.
KAIA_DATASET_SEED=kaia-kalundborg-2026
KAIA_DATASET_VERSION=KAIA-DEMO-2026.09-v4
KAIA_REFERENCE_DATE=2026-09-30
KAIA_LAKE_MODE=postgres
KAIA_CONTEXT_MODE=simulated
# Valgfrie eksterne gateway-kontrakter. Endpoint + allowlist + token; ingen shell fra model.
KAIA_MCP_URL=
KAIA_MCP_ALLOWED_HOST=
KAIA_MCP_TOKEN=
KAIA_CLI_RUNNER_URL=
KAIA_CLI_ALLOWED_HOST=
KAIA_CLI_RUNNER_TOKEN=
# Kun udviklingsserver på localhost. IGNORERES/AFVISES altid på Vercel og i NODE_ENV=production.
# Offentlig demologin vælges særskilt med KAIA_AUTH_MODE=demo; den bruger aldrig disse fixtures.
KAIA_TEST_MODE=0
